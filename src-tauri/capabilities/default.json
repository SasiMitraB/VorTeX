{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: VorTeX's own commands, event listening, and native file dialogs. No network, shell or filesystem plugins.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "allow-get-settings",
    "allow-set-settings",
    "allow-list-projects",
    "allow-open-project",
    "allow-close-project",
    "allow-file-tree",
    "allow-read-file",
    "allow-write-file",
    "allow-create-file",
    "allow-create-folder",
    "allow-rename-path",
    "allow-delete-path",
    "allow-open-external",
    "allow-grant-file-access",
    "allow-quit",
    "allow-index-stats",
    "allow-outline",
    "allow-labels",
    "allow-todos",
    "allow-tables",
    "allow-complete",
    "allow-main-document",
    "allow-build",
    "allow-clean-build",
    "allow-synctex-forward",
    "allow-synctex-inverse",
    "allow-git-status",
    "allow-git-history",
    "allow-git-diff",
    "allow-git-line-markers",
    "allow-latexdiff-options",
    "allow-latexdiff",
    "allow-grammar-check",
    "allow-math-at",
    "allow-math-render",
    "allow-table-load",
    "allow-table-apply",
    "allow-table-latex"
  ]
}
